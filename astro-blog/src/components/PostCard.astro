---
import type { CollectionEntry } from 'astro:content';
const { post } = Astro.props as { post: CollectionEntry<'posts'> };
const date = post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
---
<article class="post-card">
  <div class="post-meta"><span>{post.data.category}</span><time datetime={post.data.pubDate.toISOString()}>{date}</time></div>
  <h2><a href={`/${post.data.legacyPath}/`}>{post.data.title}</a></h2>
  <p>{post.data.description}</p>
  <div class="tag-list">{post.data.tags.map((tag) => <a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>)}</div>
</article>
