---
import { site } from '../data/site';
const pathname = Astro.url.pathname;
const links = [
  ['/', '首页'], ['/archives/', '归档'], ['/categories/', '分类'],
  ['/tags/', '标签'], ['/about/', '关于'],
];
---
<header class="site-header">
  <a class="brand" href="/"><img src="/images/avatar.jpg" alt="" /><span>{site.title}</span></a>
  <nav aria-label="主导航">
    {links.map(([href, label]) => <a href={href} aria-current={pathname === href ? 'page' : undefined}>{label}</a>)}
  </nav>
</header>
